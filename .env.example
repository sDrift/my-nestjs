# 环境变量模板：复制为 .env 后按实际值填写
#   cp .env.example .env   （Windows PowerShell: Copy-Item .env.example .env）
#
# 注意：
#   1) .env 里有真实数据库密码，已在 .gitignore 排除，千万不要提交进 Git
#   2) 应用启动时会对下面这些变量做校验（src/config/env.validation.ts）：
#      必填项缺失 / 端口不是数字 / 生产环境 CORS_ORIGINS 为空 → 直接启动失败并打印原因
#      —— 这就是"宁可起不来，也不要带病上线"
#
# 原注释：无（本项目生产化改造新增）
# 对照 Java：等价于 Spring Boot 的 application.properties / application-{profile}.properties
# 前端(Vue3)：等价于项目根目录的 .env.development / .env.production
#     —— Vite 靠 VITE_ 前缀注入 import.meta.env，NestJS 靠 ConfigService 注入

# ───────── 运行环境 ─────────
# 可选值：development | production | test（默认 development）
# 影响：pino 日志格式（pretty / JSON）、TypeORM 连接池大小、CORS 强校验
NODE_ENV=development

# ───────── HTTP 服务 ─────────
# 服务监听端口（默认 3000）
PORT=3000

# ───────── CORS 跨域白名单 ─────────
# 允许访问本 API 的前端域名，逗号分隔
#   - 开发环境：可留空（留空 = 放行所有来源，方便调试）
#   - 生产环境：必须填写，否则启动直接失败（空值在生产会有安全风险）
# 例：https://your-frontend.com,https://admin.your-frontend.com
CORS_ORIGINS=

# ───────── 数据库（MySQL，必填）─────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_db
