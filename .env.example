# 复制为 .env 后填实际值
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_db
PORT=3000

# 运行环境：development 或 production（影响 pino 日志格式、CORS 策略等）
NODE_ENV=development

# CORS 允许的前端域名白名单，逗号分隔；为空则允许所有（仅开发环境推荐）
# 生产环境必须配白名单，例：https://your-frontend.com,https://admin.your-frontend.com
CORS_ORIGINS=
