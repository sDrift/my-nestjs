# 生产环境变量模板：部署到服务器时复制为 .env（或直接配到容器的环境变量里）
#   cp .env.production.example .env
#
# 与 .env.example（开发用）的区别：
#   - NODE_ENV=production：日志输出纯 JSON、TypeORM 连接池放大、关闭 pino-pretty
#   - CORS_ORIGINS 必填：生产环境为空会导致应用启动失败（安全红线）
#
# 原注释：无（本项目生产化改造新增）
# 对照 Java：application-prod.properties
# 前端(Vue3)：等价于 .env.production（build 时生效的那份）

NODE_ENV=production

# 容器内一般监听 3000（宿主机端口映射在 docker-compose.yml 里配）
PORT=3000

# ⚠️ 必填：前端实际域名（多个用逗号分隔，不要带结尾的 /）
CORS_ORIGINS=https://your-frontend.com

# 生产数据库地址：容器编排时通常填服务名（如 mysql），不是 localhost
DB_HOST=mysql
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_db
